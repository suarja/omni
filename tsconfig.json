{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest"]
  },
  "include": ["src", "tests", "vite.config.ts"],
  "exclude": ["tests/fixtures/stack/**/*.ts", "tests/fixtures/stack/**/*.tsx"]
}
